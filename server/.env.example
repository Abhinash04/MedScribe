# Copy to server/.env and fill in. server/.env is gitignored.
#
# Values here are read at process start, so `npm run proxy` picks up a new key
# with no rebuild and no code change. That makes this the fastest way to swap a
# credential while iterating.

VOICE_TO_TEXT_API_URL=https://anuvadini-services.aicte-india.org/api/voice-to-text
VOICE_TO_TEXT_API_KEY=replace-me

# Pravah translation. The key is supplied by the Anuvadini team and starts with
# an "apk_" prefix. Paste it bare — the `Bearer ` prefix is added in code.
PRAVAH_TRANSLATE_URL=https://pravahai.aicte-india.org/api/translatebulk
PRAVAH_API_KEY=replace-me

PORT=8787

# Copy to server/.env and fill in. server/.env is gitignored and must stay that way.
# These values live on the server only — the mobile app never receives them.

VOICE_TO_TEXT_API_URL=https://anuvadini-services.aicte-india.org/api/voice-to-text
VOICE_TO_TEXT_API_KEY=replace-me

# Optional. The app's debug build expects 8787.
PORT=8787
